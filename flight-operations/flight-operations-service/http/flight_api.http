### Log in first: password grant, the access token goes into access_token for the requests below
POST {{keycloak}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{client-id}}&client_secret={{client-secret}}&username={{username}}&password={{password}}&scope=openid

> {%
    client.global.set("access_token", response.body.access_token);
%}

### The flights of today (UTC). The first one is the flight of the requests below
GET {{api}}/flights
Authorization: Bearer {{access_token}}

> {%
    client.test("The answer names the day and lists its flights", function () {
        client.assert(response.status === 200 && response.body.scheduledDepartureDate !== undefined,
            "Expected 200 with the day, got " + response.status);
    });
    if (response.body.flights.length > 0) {
        client.global.set("flight_id", response.body.flights[0].id);
    }
%}

### The flights of another day: change the date to a day with flights when today has none
GET {{api}}/flights?scheduledDepartureDate=2026-01-09
Authorization: Bearer {{access_token}}

> {%
    client.test("The flights of the asked day", function () {
        client.assert(response.status === 200 && response.body.scheduledDepartureDate === "2026-01-09",
            "Expected 200 for 2026-01-09, got " + response.status);
    });
    if (response.body.flights.length > 0) {
        client.global.set("flight_id", response.body.flights[0].id);
    }
%}

### One flight by its identity, as a page of Load Planning asks for it
GET {{api}}/flights?scheduledDepartureDate=2026-01-09&flightNumber=HJ221&departureAirport=BRU
Authorization: Bearer {{access_token}}

> {%
    client.test("At most one flight", function () {
        client.assert(response.status === 200 && response.body.flights.length <= 1,
            "Expected 200 with zero or one flight, got " + response.status);
    });
%}

### Half an identity: 400 with the reason
GET {{api}}/flights?flightNumber=HJ221
Authorization: Bearer {{access_token}}

> {%
    client.test("Both or neither", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}

### Without a token: 401
GET {{api}}/flights

> {%
    client.test("No token, no answer", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### The IATA delay reasons
GET {{api}}/delay-codes
Authorization: Bearer {{access_token}}

> {%
    client.test("The list has the IATA delay reasons", function () {
        client.assert(response.status === 200 && response.body.some(reason => reason.code === "93"),
            "Expected a list with code 93");
    });
%}

### The details of a flight
GET {{api}}/flights/{{flight_id}}
Authorization: Bearer {{access_token}}

> {%
    client.test("The flight has its airports with code and name", function () {
        client.assert(response.status === 200 && response.body.departureAirport.code.length === 3,
            "Expected a flight, got " + response.status);
    });
%}

### Enter a departure delay
POST {{api}}/flights/{{flight_id}}/delays
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "kind": "DEPARTURE",
  "minutes": 25,
  "reason": "93",
  "description": "Late inbound aircraft"
}

> {%
    client.test("The delay shifts the ETD", function () {
        client.assert(response.status === 200 && response.body.etd !== response.body.std,
            "Expected 200 and an ETD later than the STD, got " + response.status);
    });
%}

### A delay reason outside the IATA list: 400 with the reason
POST {{api}}/flights/{{flight_id}}/delays
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "kind": "DEPARTURE",
  "minutes": 25,
  "reason": "50",
  "description": "Late inbound aircraft"
}

> {%
    client.test("An unknown delay reason is refused with an explanation", function () {
        client.assert(response.status === 400 && response.body.code === "invalid-input",
            "Expected 400 invalid-input, got " + response.status);
    });
%}

### Nobody changes the STD: 405
PATCH {{api}}/flights/{{flight_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "std": "2026-01-09T08:00:00Z"
}

> {%
    client.test("Scheduled times cannot be changed", function () {
        client.assert(response.status === 405, "Expected 405, got " + response.status);
    });
%}

### A flight that does not exist: 404
GET {{api}}/flights/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{access_token}}

> {%
    client.test("An unknown flight is not found", function () {
        client.assert(response.status === 404 && response.body.code === "not-found",
            "Expected 404 not-found, got " + response.status);
    });
%}

### 3V11 of 29 October: its id goes into flight_id. Schedule it first (simulator.http, "HJ221 and 3V11 of 29 October");
### the ATD below is only accepted once its load is finalized (load-planning e2e-hand-checks.http, round 1)
GET {{api}}/flights?scheduledDepartureDate=2026-10-29&flightNumber=3V11&departureAirport=BRU
Authorization: Bearer {{access_token}}

> {%
    client.test("3V11 of 29 October exists", function () {
        client.assert(response.status === 200 && response.body.flights.length === 1,
            "Expected one flight, got " + response.status);
    });
    client.global.set("flight_id", response.body.flights[0].id);
%}

### First ATD: 200
POST {{api}}/flights/{{flight_id}}/departure
Authorization: Bearer {{access_token}}
Content-Type: application/json

{"atd": "2026-10-28T11:10:00Z"}

> {%
    client.test("The first ATD is registered", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### Same ATD again: 409 "The departure of this flight has already been registered"
POST {{api}}/flights/{{flight_id}}/departure
Authorization: Bearer {{access_token}}
Content-Type: application/json

{"atd": "2026-10-28T11:10:00Z"}

> {%
    client.test("A second ATD is refused with the reason", function () {
        client.assert(response.status === 409 && response.body.code === "rule-refused",
            "Expected 409 rule-refused, got " + response.status);
    });
%}
