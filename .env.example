# Copy this file to .env and choose a value for every line. .env is not in Git.
# Docker Compose hands the values to Keycloak, which puts them in the realm when it imports
# keycloak/air-freight-realm.json. The .http files need the same values in http-client.private.env.json.
FLIGHT_OPERATIONS_SERVICE_CLIENT_SECRET=
LOAD_PLANNING_SERVICE_CLIENT_SECRET=
FLIGHT_PLANNER_PASSWORD=
LOAD_PLANNER_PASSWORD=
