### ===================================================================================================
### Exam demo, Tuesday 10 November 2026 at 14:30 Brussels (CET = UTC+1). The times below are UTC.
### The demo takes at most 10 minutes and shows the happy flow: Live 1 (HJ503) comes in, HJ501 is delayed,
### loaded, finalized and departs. HJ502 is optional, only to show the 5-minute rule when asked: it needs a
### finalized load before the exam, because a delay entered after the loading period has closed does not
### reopen it. Do not rehearse with these flights: the exam would find them finalized and departed. Rehearse
### with other flight numbers or another date, or start from an empty database.
### ===================================================================================================

### Exam demo, the schedule: send it before the exam (from now on), then the two bookings below.
### HJ501: STD 16:00 UTC (17:00 Brussels), STA 19:15 UTC. Loading period 10 Nov 05:00-16:40 Brussels.
### HJ502: STD 08:00 UTC (09:00 Brussels), STA 11:15 UTC. Loading period 9 Nov 21:00 - 10 Nov 08:40 Brussels.
POST http://localhost:8090/api/flight-schedules
Content-Type: application/json

[
  { "periodFrom": "2026-11-10", "periodTo": "2026-11-10", "weekdays": ["TUESDAY"],
    "departureTime": "16:00", "arrivalTime": "19:15", "flightNumber": "HJ501",
    "departureAirport": "BRU", "arrivalAirport": "ATH", "registration": "SXBAA" },
  { "periodFrom": "2026-11-10", "periodTo": "2026-11-10", "weekdays": ["TUESDAY"],
    "departureTime": "08:00", "arrivalTime": "11:15", "flightNumber": "HJ502",
    "departureAirport": "BRU", "arrivalAirport": "ATH", "registration": "OOTFA" }
]

> {%
    client.test("Two exam records give two SSMs", function () {
        client.assert(response.status === 202, "Response status is not 202");
        client.assert(response.body.messageIds.length === 2, "Expected two message ids");
    });
%}

### Exam demo, cargo on HJ501, positioned during the exam:
### - AKE12345HJ on CL and PMC54321HJ on CR: 1000 kg vs 2425 lb = 1099.96 kg, lateral balance just passes
###   (only AKE12345HJ on CL fails it)
### - AKE67890HJ goes to SKG: on A1 offloading passes, on DL it blocks AKE12345HJ and offloading fails
### - AKE99999HJ gets no position: the soft check warns and it stays out of the CPM
POST http://localhost:8090/api/cargo-bookings
Content-Type: application/json

[
  { "flightNumber": "HJ501", "scheduledDepartureDate": "2026-11-10", "departureAirport": "BRU",
    "uldCode": "AKE12345HJ", "weight": 1000, "weightUnit": "KG", "destination": "ATH" },
  { "flightNumber": "HJ501", "scheduledDepartureDate": "2026-11-10", "departureAirport": "BRU",
    "uldCode": "PMC54321HJ", "weight": 2425, "weightUnit": "LB", "destination": "ATH" },
  { "flightNumber": "HJ501", "scheduledDepartureDate": "2026-11-10", "departureAirport": "BRU",
    "uldCode": "AKE67890HJ", "weight": 800, "weightUnit": "KG", "destination": "SKG" },
  { "flightNumber": "HJ501", "scheduledDepartureDate": "2026-11-10", "departureAirport": "BRU",
    "uldCode": "AKE99999HJ", "weight": 500, "weightUnit": "KG", "destination": "ATH" }
]

> {%
    client.test("Four exam bookings give four ULD messages", function () {
        client.assert(response.status === 202, "Response status is not 202");
        client.assert(response.body.messageIds.length === 4, "Expected four message ids");
    });
%}

### Exam demo, cargo on HJ502. Before the exam, between 9 Nov 21:00 and 10 Nov 08:40 Brussels, the load
### planner puts AKE11111HJ on CL and AKE22222HJ on CR and finalizes the load.
### During the exam the flight planner registers ATD 09:20 Brussels: refused, more than 5 minutes after
### the ETD. Enter a departure delay of 15 minutes, then the same ATD is accepted: exactly ETD + 5 minutes,
### the boundary that is allowed (MVT-ED, MVT-EA, MVT-AD).
### An ATA of now (after 11:40 UTC) is refused too: enter an arrival delay first, or register the ATA
### at most 5 minutes after the ETA.
POST http://localhost:8090/api/cargo-bookings
Content-Type: application/json

[
  { "flightNumber": "HJ502", "scheduledDepartureDate": "2026-11-10", "departureAirport": "BRU",
    "uldCode": "AKE11111HJ", "weight": 1000, "weightUnit": "KG", "destination": "ATH" },
  { "flightNumber": "HJ502", "scheduledDepartureDate": "2026-11-10", "departureAirport": "BRU",
    "uldCode": "AKE22222HJ", "weight": 1000, "weightUnit": "KG", "destination": "ATH" }
]

> {%
    client.test("Two exam bookings give two ULD messages", function () {
        client.assert(response.status === 202, "Response status is not 202");
        client.assert(response.body.messageIds.length === 2, "Expected two message ids");
    });
%}

