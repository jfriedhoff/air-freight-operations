Content-Type: application/json

[
  { "flightNumber": "HJ221", "scheduledDepartureDate": "2026-10-12", "departureAirport": "BRU",
    "uldCode": "AKE16689R7", "weight": 1250.5, "weightUnit": "KG", "destination": "ATH" },
  { "flightNumber": "HJ221", "scheduledDepartureDate": "2026-10-12", "departureAirport": "BRU",
    "uldCode": "PMC12345KL", "weight": 2646, "weightUnit": "LB", "destination": "ATH" },
  { "flightNumber": "HJ221", "scheduledDepartureDate": "2026-10-12", "departureAirport": "BRU",
    "uldCode": "AKE22222R7", "weight": 980, "weightUnit": "KG", "destination": "SKG" }
]

> {%
    client.test("Three records give three ULD messages", function () {
        client.assert(response.status === 202, "Response status is not 202");
        client.assert(response.body.messageIds.length === 3, "Expected three message ids");
    });
%}

